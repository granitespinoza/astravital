# AI assistance: OpenAI Codex. Template only; contains no credentials.
# Startup consumes process environment. Do not assume this file is automatically loaded.
HOST=127.0.0.1
PORT=4173
DB_PATH=.runtime/demo.sqlite
SEED=142

# npm run setup:voice reads models/manifest.json and stores the verified model under models/.
# Set the executable override only when whisper-cli is not found in PATH.
WHISPER_MODEL=base
# WHISPER_CPP_BIN=/absolute/path/to/whisper-cli

# Reserved for a future separately implemented Azure profile; not consumed merely by setting them.
# RUN_PROFILE=azure
# DATABASE_URL=
# AZURE_SPEECH_REGION=
# AZURE_SPEECH_ENDPOINT=
# AZURE_KEY_VAULT_URI=
# AZURE_STORAGE_ACCOUNT=
# SYNC_ENDPOINT=
# Never place an Azure key or database password in frontend files or committed values.
